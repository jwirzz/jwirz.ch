---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { MICRO } from "@consts";

const data = (await getCollection("micro"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

type Acc = {
  [year: string]: CollectionEntry<"micro">[];
};

const entries = data.reduce((acc: Acc, entry) => {
  const year = entry.data.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(entry);
  return acc;
}, {});

const years = Object.keys(entries).sort((a, b) => parseInt(b) - parseInt(a));
---

<PageLayout title={MICRO.TITLE} description={MICRO.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate font-semibold text-black dark:text-white">
        Micro
      </div>
      <div class="space-y-10">
        {years.length === 0 ? (
          <div class="animate">Nothing here yet.</div>
        ) : (
          years.map((year) => (
            <section class="animate space-y-6">
              <div class="font-semibold text-black dark:text-white">{year}</div>
              <div class="space-y-8">
                {entries[year].map(async (entry) => {
                  const { Content } = await entry.render();
                  return (
                    <div class="space-y-2 pb-8 border-b border-black/10 dark:border-white/10 last:border-0 last:pb-0">
                      <div class="text-sm text-black/40 dark:text-white/40">
                        <FormattedDate date={entry.data.date} />
                      </div>
                      <article class="prose dark:prose-invert max-w-full prose-sm">
                        <Content />
                      </article>
                    </div>
                  );
                })}
              </div>
            </section>
          ))
        )}
      </div>
    </div>
  </Container>
</PageLayout>
