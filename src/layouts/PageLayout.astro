---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={`${title} | ${SITE.NAME}`} description={description} />
  </head>
  <body>
    <div id="texture-overlay"></div>
    <div id="cursor-follower">
      <div id="blob" class="blob"></div>
    </div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import { gsap, Power2 } from "gsap";

  let tickerCallback: (() => void) | null = null;
  let abortController: AbortController | null = null;

  function init() {
    const isTouchDevice = window.matchMedia("(hover: none)").matches;
    if (isTouchDevice) return;

    if (abortController) abortController.abort();
    abortController = new AbortController();
    const { signal } = abortController;

    if (tickerCallback) gsap.ticker.remove(tickerCallback);

    const mouse = { x: 0, y: 0 };
    const pos = { x: 0, y: 0 };
    const ratio = 0.65;
    const blob = document.getElementById("blob");
    const magicCursor = document.getElementById("cursor-follower");

    if (!blob || !magicCursor) return;

    gsap.set(blob, { xPercent: -50, yPercent: -50 });

    document.addEventListener("mousemove", (e) => {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
      mouse.x = e.pageX;
      mouse.y = e.pageY - scrollTop;
    }, { signal });

    tickerCallback = () => {
      pos.x += (mouse.x - pos.x) * ratio;
      pos.y += (mouse.y - pos.y) * ratio;
      gsap.to(blob, { duration: 0.5, x: pos.x, y: pos.y });
    };
    gsap.ticker.add(tickerCallback);

    document.querySelectorAll("[data-cursor-hover]").forEach((wrap) => {
      wrap.addEventListener("mouseenter", () => gsap.to(blob, { duration: 0.5, opacity: 0.5 }), { signal });
      wrap.addEventListener("mouseleave", () => {
        gsap.to(blob, { duration: 0.5, opacity: 0.2 });
        if (wrap.hasAttribute("data-cursor-parallax")) {
          gsap.to(wrap, { duration: 0.3, scale: 1, x: 0, y: 0 });
        }
      }, { signal });
      wrap.addEventListener("mousemove", (e) => {
        if (wrap.hasAttribute("data-cursor-parallax")) {
          const me = e as MouseEvent;
          const rect = wrap.getBoundingClientRect();
          const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
          gsap.to(wrap, {
            duration: 0.3,
            x: ((me.pageX - rect.left - rect.width / 2) / rect.width) * 10,
            y: ((me.pageY - rect.top - rect.height / 2 - scrollTop) / rect.height) * 10,
            ease: Power2.easeOut,
          });
        }
      }, { signal });
    });

    magicCursor.classList.add("active");
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
  document.addEventListener("astro:after-swap", init);
</script>
